<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Lets the receiving app read the card through a temporary content:// grant; no storage permission needed -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.quoteshare.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/quoteshare_paths" />
        </provider>
    </application>
</manifest>
