{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "allow-check-update",
    "allow-install-update",
    "core:window:allow-start-dragging",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "quoteshare:default",
    "readaloud:default",
    "lansync:default"
  ]
}
